{
  "id": "cardano-defi-mcp",
  "name": "Cardano DeFi MCP",
  "publisher": "ardey26",
  "official": false,
  "repo": "https://github.com/ardey26/cardano-defi-mcp",
  "connect": [
    { "transport": "http", "url": "https://cardano-defi-mcp.onrender.com/mcp" }
  ],
  "auth": "none",
  "tools": [
    { "name": "get_quote", "capability": "trade.cross_chain_swap", "effect": "read" },
    { "name": "build_swap_tx", "capability": "trade.cross_chain_swap", "effect": "unsigned_tx" },
    { "name": "get_balance", "capability": "wallet.balance", "effect": "read" },
    { "name": "get_position", "capability": "data.position", "venues": ["indigo", "liqwid"], "effect": "read" },
    { "name": "get_market_data", "capability": "data.market", "venues": ["liqwid"], "effect": "read" },
    { "name": "open_cdp", "capability": "mint.cdp", "venues": ["indigo"], "effect": "unsigned_tx" },
    { "name": "close_cdp", "capability": "mint.cdp", "venues": ["indigo"], "effect": "unsigned_tx" }
  ],
  "notes": "Holds no keys: every fund-touching tool returns an unsigned transaction. The hosted instance sleeps when idle, so the first call can take ~30 s. `npx -y github:ardey26/cardano-defi-mcp` with no subcommand runs this server and cardano-defi-mcp-wallet together over stdio."
}
