# Blockfrost project id (free tier: https://blockfrost.io) — required for get_balance and Indigo tx building
BLOCKFROST_PROJECT_ID=

# BazaarSwap API base URL (the closed-source routing backend this server calls as a client)
BAZAAR_API_URL=http://localhost:3001

# Liqwid public GraphQL endpoint (read-only)
LIQWID_GRAPHQL_URL=https://v2.api.liqwid.finance/graphql

# mainnet | preprod
CARDANO_NETWORK=mainnet
