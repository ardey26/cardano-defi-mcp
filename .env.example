# Blockfrost project id (free tier: https://blockfrost.io) — required for get_balance and Indigo tx building
BLOCKFROST_PROJECT_ID=

# BazaarSwap API base URL (the closed-source routing backend this server calls as a client)
BAZAAR_API_URL=http://localhost:3001

# Liqwid public GraphQL endpoint (read-only)
LIQWID_GRAPHQL_URL=https://v2.api.liqwid.finance/graphql

# mainnet | preprod
CARDANO_NETWORK=mainnet

# Indigo public analytics API (read-only CDP lookups)
INDIGO_API_URL=https://analytics.indigoprotocol.io

# Indigo SystemParams JSON — required by open_cdp / close_cdp only. Indigo hosts the
# current mainnet file (undocumented; the filename changes each protocol upgrade):
#   https://config.indigoprotocol.io/mainnet/mainnet-system-params-v3.json
# Alternatively set INDIGO_SYSTEM_PARAMS_FILE to a local path.
INDIGO_SYSTEM_PARAMS_URL=
